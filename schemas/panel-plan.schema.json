{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://text-to-comic.local/schemas/panel-plan.schema.json",
  "title": "TextToComic Panel Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "story_id",
    "visual_form",
    "format",
    "language",
    "style_id",
    "panels"
  ],
  "properties": {
    "story_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "visual_form": {
      "type": "string",
      "enum": [
        "comic",
        "picture-book",
        "infographic",
        "hybrid"
      ]
    },
    "format": {
      "type": "string",
      "enum": [
        "single",
        "4-panel",
        "6-panel",
        "8-panel",
        "10-panel",
        "12-panel",
        "webtoon",
        "custom"
      ]
    },
    "genre": {
      "type": "string"
    },
    "language": {
      "type": "string"
    },
    "style_id": {
      "type": "string"
    },
    "aspect_ratio": {
      "type": "string",
      "enum": [
        "1:1",
        "4:5",
        "16:9",
        "9:16",
        "custom"
      ]
    },
    "source_summary": {
      "type": "string"
    },
    "target_audience": {
      "type": "string"
    },
    "character_bible": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "character_id",
          "name",
          "appearance",
          "must_keep"
        ],
        "properties": {
          "character_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "appearance": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "age_presentation": {
                "type": "string"
              },
              "hair": {
                "type": "string"
              },
              "face": {
                "type": "string"
              },
              "eyewear": {
                "type": "string"
              },
              "outfit": {
                "type": "string"
              },
              "accent_color": {
                "type": "string"
              },
              "build": {
                "type": "string"
              },
              "vibe": {
                "type": "string"
              }
            }
          },
          "must_keep": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "hard_anchors": {
            "type": "array",
            "description": "可选。不写则由 appearance 的 hair/eyewear/build/face 自动推导。",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "key",
                "must_keep_value"
              ],
              "properties": {
                "key": {
                  "type": "string",
                  "description": "对应 appearance 的字段名，如 hair"
                },
                "label_zh": {
                  "type": "string"
                },
                "must_keep_value": {
                  "type": "string"
                },
                "must_match": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "reference_image": {
            "type": "string",
            "description": "可选。该角色的参考图路径，首格渲染时提示带上。"
          }
        }
      }
    },
    "panels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "panel_id",
          "narrative_role",
          "shot",
          "scene",
          "action",
          "emotion",
          "dialogue",
          "must_include",
          "avoid"
        ],
        "properties": {
          "panel_id": {
            "type": "integer",
            "minimum": 1
          },
          "narrative_role": {
            "type": "string",
            "enum": [
              "setup",
              "build",
              "twist",
              "payoff",
              "transition",
              "explain",
              "cta",
              "cover"
            ]
          },
          "shot": {
            "type": "string",
            "enum": [
              "wide",
              "medium",
              "close-up",
              "detail",
              "overhead",
              "portrait",
              "custom"
            ]
          },
          "camera_angle": {
            "type": "string"
          },
          "scene": {
            "type": "string"
          },
          "scene_tag": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "emotion": {
            "type": "string"
          },
          "dialogue": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "speaker",
                "text"
              ],
              "properties": {
                "speaker": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                },
                "language": {
                  "type": "string"
                }
              }
            }
          },
          "caption": {
            "type": "string"
          },
          "must_include": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "avoid": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "visual_priority": {
            "type": "string"
          },
          "text_budget": {
            "type": "integer",
            "minimum": 0
          },
          "continuity_from_panel": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "assembly": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "layout": {
          "type": "string",
          "enum": [
            "single",
            "2x2",
            "2x3",
            "2x4",
            "vertical-stack",
            "custom"
          ]
        },
        "gutter_px": {
          "type": "integer",
          "minimum": 0
        },
        "caption_mode": {
          "type": "string",
          "enum": [
            "overlay",
            "below-panel",
            "none"
          ]
        },
        "background": {
          "type": "string"
        }
      }
    }
  }
}